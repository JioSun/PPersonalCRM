# Скопируйте в .env и замените значения replace-with-... своими.
# Это примеры, не настоящие секреты. Файл .env не добавляйте в Git.
# Обязательные настройки SMTP и AI нужны для загрузки Settings даже без их вызовов.

# PostgreSQL
# Для запуска Python на компьютере — localhost и опубликованный порт БД.
# Compose переопределяет POSTGRES_SERVER=postgres для backend и migration.
# Внутри Compose POSTGRES_PORT должен оставаться внутренним портом 5432.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
# Эти имя БД и пользователь соответствуют текущему compose.yaml.
# Изменение env не меняет пользователя/пароль/имя уже созданной БД в volume.
POSTGRES_DB=personalcrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-database-password

# Backend
# Замените на случайный секрет для подписи JWT, не используйте пример.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Замените на email администратора.
SUPER_ADMIN=admin@example.com

# Redis
# Для Python на компьютере — опубликованный порт Redis.
# Compose переопределяет REDIS_HOST=redis у backend;
# внутри Compose REDIS_PORT — внутренний порт 6379.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# SMTP: текущая отправка использует STARTTLS, пример для Gmail.
# Для реальной отправки нужны адрес отправителя и пароль приложения.
# Примеры ниже позволяют загрузить настройки, но не отправлять письма.
EMAIL=sender@example.com
PASSWORD=replace-with-your-smtp-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Gemini
# Реальные AI-запросы требуют действующего ключа провайдера.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Общий бюджет ожидания AI в секундах, включая повторы и паузы.
GENERAL_TIMEOUT=30

# Web: адрес API, доступный пользователю в браузере, для ссылок /pay/.
# Пример предполагает опубликованный порт API 8000 на компьютере.
# Compose публикует API на 127.0.0.1:8000, БД на 127.0.0.1:5432,
# Redis на 127.0.0.1:6379. При смене внешнего порта API обновите MAIN_URL.
# Для публичного развёртывания потребуется внешний HTTPS-адрес.
MAIN_URL=http://localhost:8000
